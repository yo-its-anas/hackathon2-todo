# Better Auth Configuration

# JWT Secret (MUST match backend BETTER_AUTH_SECRET)
# SECURITY: Minimum 32 characters. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Database URL for Better Auth user storage (can use same Neon database as backend)
# Format: postgresql://[user]:[password]@[host]/[database]?sslmode=require
DATABASE_URL=

# Better Auth API Base URL
BETTER_AUTH_URL=http://localhost:3000

# Public URL for client-side auth requests (must be prefixed with NEXT_PUBLIC_)
NEXT_PUBLIC_BETTER_AUTH_URL=http://localhost:3000

# Backend API URL (for task operations)
NEXT_PUBLIC_API_URL=http://localhost:8000
