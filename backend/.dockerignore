# Git
.git
.gitignore

# Python cache and bytecode
__pycache__
*.py[cod]
*$py.class
*.so
.Python
.pytest_cache
.coverage
htmlcov/
.tox/
.nox/
*.egg-info/
.eggs/
dist/
build/

# Virtual environments
venv/
.venv/
ENV/
env/

# IDE and editor files
.idea/
.vscode/
*.swp
*.swo

# Environment files (secrets injected via HF Spaces)
.env
.env.*
*.env

# Tests (not needed in production)
tests/
test_*.py
*_test.py
conftest.py
pytest.ini

# Documentation (not needed in container)
*.md
docs/

# Misc
*.log
.DS_Store
Thumbs.db

# Keep start.sh (entrypoint script) - explicitly NOT ignored
!start.sh
