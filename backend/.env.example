# Neon Serverless PostgreSQL connection string
# Format: postgresql://[user]:[password]@[host]/[database]?sslmode=require
DATABASE_URL=

# JWT Authentication Secret
# SECURITY: Must be minimum 32 characters. Generate with: openssl rand -base64 32
# IMPORTANT: Use the SAME secret on both backend (FastAPI) and frontend (Better Auth)
BETTER_AUTH_SECRET=

# OpenAI API key for AI chatbot
OPENAI_API_KEY=

# MCP Server port (default: 8001)
MCP_SERVER_PORT=8001

# Maximum messages to load for conversation context (default: 50)
CHAT_CONTEXT_LIMIT=50

# Rate limit for chat requests per minute per user (default: 60)
RATE_LIMIT_PER_MINUTE=60

# LLM model to use (default: gpt-4o-mini)
LLM_MODEL=gpt-4o-mini
